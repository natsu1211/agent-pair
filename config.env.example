# Example agent-pair config. Copy it to config.env in the same directory and edit; config.env is not committed.
#
# Format: one KEY=value per line; lines starting with # are comments. The file is read as data and never executed.
# Priority: --model/--effort on send > environment variables > <repo root>/.agent-pair/config.env > this file.
# Anything unset or commented out falls back to the peer CLI's own defaults.
#
# Effort values:
#   codex:  minimal | low | medium | high | xhigh
#   claude: low | medium | high | xhigh | max

# --- Codex as the peer (when used from Claude Code) ---
# PAIR_CODEX_REVIEWER_MODEL=gpt-5
# PAIR_CODEX_REVIEWER_EFFORT=high
# PAIR_CODEX_WRITER_MODEL=gpt-5
# PAIR_CODEX_WRITER_EFFORT=high

# --- Claude as the peer (when used from Codex) ---
# PAIR_CLAUDE_REVIEWER_MODEL=opus
# PAIR_CLAUDE_REVIEWER_EFFORT=high
# PAIR_CLAUDE_WRITER_MODEL=opus
# PAIR_CLAUDE_WRITER_EFFORT=high

# --- Permission-related; only honored in this global config, ignored in a repo-level config.env ---
# Extra arguments for codex exec, split on spaces
# PAIR_CODEX_EXTRA=
# Override --allowedTools for the claude peer (comma separated), e.g. to let it run tests
# PAIR_CLAUDE_REVIEWER_TOOLS=Read,Grep,Glob,Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git status:*),Bash(npm test:*)
# PAIR_CLAUDE_WRITER_TOOLS=Read,Grep,Glob,Edit,Write,MultiEdit,Bash(git diff:*),Bash(git status:*),Bash(npm test:*)
